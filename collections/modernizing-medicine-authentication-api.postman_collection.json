        {
          "id": "b6b7a520-a265-411d-9e01-8e8b24de4e74",
          "name": "Obtain OAuth2 Token (Legacy — password grant)",
          "request": {
            "name": "Obtain OAuth2 Token (Legacy — password grant)",
            "description": {
              "content": "**Legacy authentication — being sunset.** Obtain an access token using the OAuth2 `password` grant. Send your sandbox `x-api-key` plus `username`/`password`. The token is an HS256 JWT and a `refresh_token` is returned. New integrations should use the OAuth2 `client_credentials` flow described in the **Authentication** guide. Treat the returned `access_token` as an opaque Bearer token.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "ws",
                "oauth2",
                "grant"
              ],
              "host": [
                "{{ws-oauth2-grant-Url}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "x-api-key"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "grant_type",
                  "value": "password",
                  "description": "(Required) "
