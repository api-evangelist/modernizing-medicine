                {
                  "disabled": false,
                  "key": "username",
                  "value": "fhir_QfLlo",
                  "description": "(Required) The username provided to you"
                },
                {
                  "disabled": false,
                  "key": "password",
                  "value": "925X3LZ505",
                  "description": "(Required) The password provided to you"
