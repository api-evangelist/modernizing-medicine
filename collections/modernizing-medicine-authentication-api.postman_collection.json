        {
          "id": "e6ca0016-18b5-499a-b72f-4fb4fc4074d3",
          "name": "Authorization endpoint (authorization_code)",
          "request": {
            "name": "Authorization endpoint (authorization_code)",
            "description": {
              "content": "Begin the SMART App Launch `authorization_code` flow. Redirect the user's browser here; on approval the server redirects to your `redirect_uri` with a `code` to exchange at the token endpoint. PKCE (`S256`) is supported.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "auth",
                "realms",
                "fhir",
                "protocol",
                "openid-connect",
                "auth"
              ],
              "host": [
                "{{auth-realms-fhir-protocol-openid-connect-auth-Url}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "response_type",
                  "value": "code",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "key": "client_id",
                  "value": "<string>",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "key": "redirect_uri",
                  "value": "<string>",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "key": "scope",
                  "value": "<string>",
                  "description": "(Required) Space-separated SMART scopes"
                },
                {
                  "disabled": false,
                  "key": "state",
                  "value": "<string>",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "key": "aud",
                  "value": "<string>",
                  "description": "(Required) The FHIR base URL of the endpoint you're connecting to (a customer endpoint from the directory, or the demonstration endpoint for testing)"
                },
                {
                  "disabled": false,
                  "key": "code_challenge",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "code_challenge_method",
                  "value": "S256"
                }
              ],
              "variable": []
            },
            "method": "GET",
            "auth": null
          },
