            "params": [
              {
                "name": "id",
                "value": "123",
                "type": "path",
                "description": "The resource ID"
              }
            ]
          },
          "docs": "read-instance: Read DocumentReference instance"
        },
        {
          "info": {
            "name": "search-type: Search for DocumentReference instances",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://fhirmp.mmi.prod.fhir.ema-api.com/fhir/r4/DocumentReference",
            "params": [
              {
                "name": "_id",
                "value": "",
                "type": "query",
                "description": "The ID of the resource"
              },
              {
                "name": "category",
                "value": "",
                "type": "query",
                "description": "Categorization of document"
              },
              {
                "name": "date",
                "value": "",
                "type": "query",
                "description": "When this document reference was created"
              },
              {
                "name": "patient",
                "value": "",
                "type": "query",
                "description": "Who/what is the subject of the document"
              },
              {
                "name": "period",
                "value": "",
                "type": "query",
                "description": "Time of service that is being documented"
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "current | superseded | entered-in-error"
